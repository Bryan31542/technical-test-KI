# Copy to .env in this same directory. The stack reads only this file.

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# Optional. If empty or it still contains ${...}, the API builds it from POSTGRES_* (localhost).
DATABASE_URL=

# API / panel
CORS_ORIGIN=http://localhost:3000
API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# db (no Twilio) or twilio
MESSAGING_DRIVER=db
TWILIO_WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CONTENT_SID=

# HTTP Basic for /cases. Webhook and /health stay public.
PANEL_USER=
# Base64 of a bcrypt $2b$ hash (Compose interpolates raw $ in this file).
PANEL_PASSWORD_HASH=
