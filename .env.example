# Copy to .env in this same directory. Demo values are enough to run locally.
# Do not commit .env.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=casos
POSTGRES_PORT=5432
# Optional. Empty or ${...} → the API builds it from POSTGRES_* (localhost).
DATABASE_URL=

# API / panel
CORS_ORIGIN=http://localhost:3000
API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# db = replies stay in the database (no Twilio). twilio = second adapter.
MESSAGING_DRIVER=db
TWILIO_WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CONTENT_SID=

# HTTP Basic on /cases only. Webhook and /health stay public.
# Password is "panel". Value is bcrypt $2b$ in base64 (Compose breaks a raw $2b$ hash).
PANEL_USER=panel
PANEL_PASSWORD_HASH=JDJiJDEwJG1pWFV4Wnh2Z1pSQkdNeHZCcm1hUWU5SnRqYzN4dzE4QUFwTERLZ1lFZFFzS3BFQmpJME8y
